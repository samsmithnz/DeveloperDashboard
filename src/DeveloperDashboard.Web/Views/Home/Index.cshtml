@model PortfolioViewModel
@{ ViewData["Title"] = "Portfolio"; }
<div class="page-heading">
    <div><div class="eyebrow">YOUR ENGINEERING SYSTEM, AT A GLANCE</div><h1>Portfolio overview</h1><p>Understand the gaps. Focus on the next improvement.</p></div>
    <div class="sync"><span>Sample snapshot · 12 minutes ago</span><button type="button" class="btn btn-dark" id="sync-demo">Sync now <span aria-hidden="true">&#8635;</span></button></div>
</div>
<div id="sync-feedback" class="notice" role="status" hidden></div>
<section class="summary-grid" aria-label="Separate portfolio indicators">
    <article class="summary"><span>Assessed repositories</span><strong>4 <small>opted in</small></strong><p>3 teams · 2 critical services</p></article>
    <article class="summary"><span>Governance</span><strong>2 <small>need attention</small></strong><p>Branch policies and required checks</p></article>
    <article class="summary"><span>Security</span><strong>1 <small>unhealthy</small></strong><p>2 repositories have unknown status</p></article>
    <article class="summary"><span>Data freshness</span><strong>3<small> of 4 current</small></strong><p>1 repository needs a fresh collection</p></article>
</section>
<div class="priority-callout"><span class="priority-icon" aria-hidden="true">!</span><div><strong>A critical dependency alert needs attention</strong><p>payments-api · Commerce · SEC-05 · Sample finding</p></div><a asp-action="Recommendations">Review recommendations &rarr;</a></div>
<section class="panel">
    <div class="panel-heading"><div><h2>Repository inventory</h2><p>Opted-in repositories only. Each dimension stands on its own.</p></div><span class="subtle">@Model.Repositories.Count results</span></div>
    <form class="filters" method="get">
        <div><label for="search">Search repositories</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by name or description" /></div>
        <div><label for="team">Owner team</label><select id="team" name="team" class="form-select"><option value="">All teams</option>@foreach (var team in PrototypeData.Repositories.Select(r => r.Team).Distinct()) { <option selected="@(Model.Team == team)" value="@team">@team</option> }</select></div>
        <button class="btn btn-outline-dark" type="submit">Apply filters</button><a asp-action="Index" class="reset">Reset</a>
    </form>
    <div class="table-responsive"><table class="table inventory"><caption class="visually-hidden">Repository governance, security, flow and freshness indicators</caption><thead><tr><th>Repository / owner</th><th>Criticality</th><th>Governance</th><th>Security</th><th>Flow</th><th>Freshness</th></tr></thead><tbody>
    @foreach (var repo in Model.Repositories)
    {
        <tr><td><a class="repo-name" asp-action="Repository" asp-route-id="@repo.Slug">@repo.Name <span aria-hidden="true">&nearr;</span></a><small>@repo.Team</small></td><td>@repo.Criticality</td>
        @foreach (var status in new[] { repo.Governance, repo.Security, repo.Flow, repo.Freshness }) { <td><span class="state @PrototypeData.Tone(status)">@status</span></td> }
        </tr>
    }
    @if (Model.Repositories.Count == 0) { <tr><td colspan="6" class="empty">No repositories match these filters. Try another search or reset the filters.</td></tr> }
    </tbody></table></div>
    <div class="panel-foot">Unknown means unavailable evidence, not a clean bill of health. No overall engineering score.</div>
</section>
